# syntax=docker/dockerfile:1

# =============================================================
# Dockerfile.prod — Frontend CST Next.js
# Production uniquement
# Mode : Next.js standalone
# =============================================================

FROM node:20-alpine AS deps

WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1

COPY package.json package-lock.json* ./

RUN npm ci


FROM node:20-alpine AS builder

WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1

# Les variables NEXT_PUBLIC_* sont intégrées au moment du build Next.js.
ARG NEXT_PUBLIC_SITE_URL=https://cst.ecc.bj
ARG NEXT_PUBLIC_API_URL=http://cst-backend:8000/api/v1
ARG NEXT_PUBLIC_DATA_SOURCE=mock
ARG NEXT_PUBLIC_NEWS_SOURCE=api
ARG NEXT_PUBLIC_GALLERY_SOURCE=api
ARG NEXT_PUBLIC_DOCUMENTS_SOURCE=api

ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_DATA_SOURCE=$NEXT_PUBLIC_DATA_SOURCE
ENV NEXT_PUBLIC_NEWS_SOURCE=$NEXT_PUBLIC_NEWS_SOURCE
ENV NEXT_PUBLIC_GALLERY_SOURCE=$NEXT_PUBLIC_GALLERY_SOURCE
ENV NEXT_PUBLIC_DOCUMENTS_SOURCE=$NEXT_PUBLIC_DOCUMENTS_SOURCE

COPY --from=deps /app/node_modules ./node_modules
COPY . .

RUN npm run build


FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Utilisateur non-root dédié au projet CST.
RUN addgroup -g 1001 -S cstgroup \
    && adduser -S -D -H -u 1001 -G cstgroup cstuser

COPY --from=builder /app/public ./public
COPY --from=builder --chown=cstuser:cstgroup /app/.next/standalone ./
COPY --from=builder --chown=cstuser:cstgroup /app/.next/static ./.next/static

USER cstuser

EXPOSE 3000

CMD ["node", "server.js"]
