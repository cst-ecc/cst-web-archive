# =============================================================
# CST / CSMO — développement Docker
# Copier en docker/.env.dev et ne jamais commiter le fichier réel.
# =============================================================

# Frontend — on conserve le mock pendant l'Étape 2.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_DATA_SOURCE=mock

# Django
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,cst-backend,cst-gateway
POSTGRES_CONN_MAX_AGE=0

# PostgreSQL CST uniquement
POSTGRES_DB=cst
POSTGRES_USER=cst
POSTGRES_PASSWORD=cst-dev-change-me
POSTGRES_PORT=5432

# CORS / CSRF
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8080

# E-mail — console en développement
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=CST/CSMO <noreply@ecc.bj>

# OTP — implémenté à l'Étape 3
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Uploads
MAX_IMAGE_UPLOAD_MB=15
MAX_DOCUMENT_UPLOAD_MB=50

# HTTPS / HSTS désactivé en local
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
