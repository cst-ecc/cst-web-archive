# =============================================================
# Variables d'environnement — CST Platform
# Copier en .env dans le même dossier (docker/)
# =============================================================

# ---------- Frontend (Next.js) ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_DATA_SOURCE=mock

# ---------- Backend (Django) — phase suivante ----------
# DJANGO_SECRET_KEY=changez-moi-en-production
# DJANGO_DEBUG=True
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL=postgres://cst:cst@db:5432/cst
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------- PostgreSQL — phase suivante ----------
# POSTGRES_DB=cst
# POSTGRES_USER=cst
# POSTGRES_PASSWORD=cst
