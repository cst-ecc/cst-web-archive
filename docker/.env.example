# =============================================================
# CST / CSMO — Exemple d'environnement
#
# Copier ce fichier selon le besoin :
#   cp docker/.env.example docker/.env.dev
#   cp docker/.env.prod.example docker/.env.prod
#
# Ne jamais commiter .env.dev ni .env.prod avec de vraies valeurs.
# =============================================================

# -------------------------------------------------------------
# Frontend Next.js
# -------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:8080
NEXT_PUBLIC_DATA_SOURCE=mock
NEXT_PUBLIC_NEWS_SOURCE=api
NEXT_PUBLIC_GALLERY_SOURCE=api
NEXT_PUBLIC_DOCUMENTS_SOURCE=api
NEXT_PUBLIC_API_URL=http://cst-backend:8000/api/v1

# -------------------------------------------------------------
# Django
# -------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=dev-only-change-me-not-for-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,cst-backend,cst-backend-dev,cst_backend_dev,cst-gateway,cst-gateway-dev,cst_gateway_dev

# -------------------------------------------------------------
# PostgreSQL CST uniquement
# -------------------------------------------------------------
POSTGRES_DB=cst
POSTGRES_USER=cst
POSTGRES_PASSWORD=cst_dev_password
POSTGRES_HOST=cst-db
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# -------------------------------------------------------------
# CORS / CSRF
# -------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8080

# -------------------------------------------------------------
# E-mail
# En développement : console.
# En production : SMTP du domaine ecc.bj.
# -------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=CST/CSMO <noreply@ecc.bj>

# -------------------------------------------------------------
# OTP back-office
# -------------------------------------------------------------
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_PENDING_SESSION_MINUTES=10

# -------------------------------------------------------------
# Sécurité back-office
# -------------------------------------------------------------
BACKOFFICE_SESSION_MAX_AGE=28800
BACKOFFICE_LOGIN_MAX_ATTEMPTS=5
BACKOFFICE_LOGIN_IP_MAX_ATTEMPTS=25
BACKOFFICE_LOGIN_WINDOW_MINUTES=15
BACKOFFICE_LOGIN_LOCKOUT_MINUTES=15

# -------------------------------------------------------------
# Uploads
# -------------------------------------------------------------
MAX_IMAGE_UPLOAD_MB=30
MAX_DOCUMENT_UPLOAD_MB=100

# -------------------------------------------------------------
# HTTPS / HSTS
# En développement : 0 / False.
# En production : commencer à 0, valider le HTTPS, puis durcir.
# -------------------------------------------------------------
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# -------------------------------------------------------------
# Redis / Celery
# -------------------------------------------------------------
CELERY_BROKER_URL=redis://cst-redis:6379/0
CELERY_RESULT_BACKEND=redis://cst-redis:6379/0
CELERY_TASK_TIME_LIMIT=900
CELERY_TASK_SOFT_TIME_LIMIT=840
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_CONCURRENCY=2

# -------------------------------------------------------------
# Galerie chunkée
# -------------------------------------------------------------
GALLERY_CHUNK_SIZE_MB=8
GALLERY_MAX_ORIGINAL_IMAGE_MB=150
GALLERY_MAX_FILES_PER_SELECTION=200
GALLERY_UPLOAD_SESSION_TTL_HOURS=24
